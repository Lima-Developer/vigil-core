{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vigil workspace telemetry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "metrics",
    "samples",
    "collector"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sqlCalls",
        "meanExecutionMillis",
        "waitingSessions",
        "freeLocalStorage",
        "localUsableBytes"
      ],
      "properties": {
        "sqlCalls": {
          "$ref": "#/$defs/metric"
        },
        "meanExecutionMillis": {
          "$ref": "#/$defs/metric"
        },
        "waitingSessions": {
          "$ref": "#/$defs/metric"
        },
        "freeLocalStorage": {
          "$ref": "#/$defs/metric"
        },
        "localUsableBytes": {
          "$ref": "#/$defs/metric"
        }
      }
    },
    "samples": {
      "type": "array",
      "maxItems": 120,
      "items": {
        "$ref": "#/$defs/sample"
      }
    },
    "collector": {
      "$ref": "#/$defs/collector"
    }
  },
  "$defs": {
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observedAt", "windowStart", "targetId", "state", "quality", "calls",
        "executionMillis", "meanExecutionMillis", "rows", "sharedHits", "sharedReads",
        "tempReads", "tempWrites", "activeSessions", "waitingSessions", "blockedSessions", "reason"
      ],
      "properties": {
        "observedAt": {"type": "string", "format": "date-time"},
        "windowStart": {"type": ["string", "null"], "format": "date-time"},
        "targetId": {"type": "string", "minLength": 1},
        "state": {"enum": ["available", "warming_up", "error"]},
        "quality": {"enum": ["measured", "partial", "unknown"]},
        "calls": {"$ref": "#/$defs/nullableNonNegativeNumber"},
        "executionMillis": {"$ref": "#/$defs/nullableNonNegativeNumber"},
        "meanExecutionMillis": {"$ref": "#/$defs/nullableNonNegativeNumber"},
        "rows": {"$ref": "#/$defs/nullableNonNegativeNumber"},
        "sharedHits": {"$ref": "#/$defs/nullableNonNegativeNumber"},
        "sharedReads": {"$ref": "#/$defs/nullableNonNegativeNumber"},
        "tempReads": {"$ref": "#/$defs/nullableNonNegativeNumber"},
        "tempWrites": {"$ref": "#/$defs/nullableNonNegativeNumber"},
        "activeSessions": {"$ref": "#/$defs/nullableNonNegativeNumber"},
        "waitingSessions": {"$ref": "#/$defs/nullableNonNegativeNumber"},
        "blockedSessions": {"$ref": "#/$defs/nullableNonNegativeNumber"},
        "reason": {"type": ["string", "null"]}
      }
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "paused", "collecting", "lastSuccess", "lastFailure", "consecutiveFailures", "reason"],
      "properties": {
        "enabled": {"type": "boolean"},
        "paused": {"type": "boolean"},
        "collecting": {"type": "boolean"},
        "lastSuccess": {"type": ["string", "null"], "format": "date-time"},
        "lastFailure": {"type": ["string", "null"]},
        "consecutiveFailures": {"type": "integer", "minimum": 0},
        "reason": {"type": ["string", "null"]}
      }
    },
    "nullableNonNegativeNumber": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "targetId",
        "observedAt",
        "window",
        "unit",
        "state",
        "quality",
        "value",
        "reason"
      ],
      "properties": {
        "source": {
          "enum": [
            "filesystem",
            "pg_stat_statements",
            "pg_stat_activity",
            "provider"
          ]
        },
        "targetId": {
          "type": "string",
          "minLength": 1
        },
        "observedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "window": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "type": "string",
                  "format": "date-time"
                },
                "end": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          ]
        },
        "unit": {
          "enum": [
            "bytes",
            "calls",
            "ms",
            "sessions"
          ]
        },
        "state": {
          "enum": [
            "available",
            "stale",
            "unsupported",
            "error",
            "warming_up"
          ]
        },
        "quality": {
          "enum": [
            "measured",
            "partial",
            "unknown"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "available",
                  "stale"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              },
              "observedAt": {
                "type": "string",
                "format": "date-time"
              },
              "quality": {
                "enum": [
                  "measured",
                  "partial"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              },
              "observedAt": {
                "type": "null"
              },
              "window": {
                "type": "null"
              },
              "quality": {
                "const": "unknown"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "available"
              },
              "quality": {
                "const": "measured"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
